# ============================================================================
# OpenAlgo NAS Deployment — Complete Environment Template
# ============================================================================
# PURPOSE: Full .env for Synology NAS Docker deployment.
#          Replaces (not overlays) .sample.env for NAS use.
#
# HOW TO USE:
#   1. Copy this file:
#        cp env.nas.sample /volume1/docker/openalgo/env/.env
#   2. Fill in the REQUIRED values marked below
#   3. Generate secret keys with:
#        ssh nas "python3 -c 'import secrets; print(secrets.token_hex(32))'"
#
# NOTE: Do NOT edit .sample.env for NAS settings — it tracks upstream
#       OpenAlgo and will be overwritten on merge. All NAS config lives here.
# ============================================================================

ENV_CONFIG_VERSION = '1.0.6'

# ----------------------------------------------------------------------------
# Broker — placeholder values satisfy startup validation in paper/sandbox mode
# Replace with real credentials when connecting a live broker
# ----------------------------------------------------------------------------
BROKER_API_KEY = 'not_configured'
BROKER_API_SECRET = 'not_configured'
BROKER_API_KEY_MARKET = ''
BROKER_API_SECRET_MARKET = ''
REDIRECT_URL = 'http://192.168.1.72:8080/zerodha/callback'

VALID_BROKERS = 'zerodha'

# ----------------------------------------------------------------------------
# Security — REQUIRED: generate unique values before first run
#   ssh nas "python3 -c 'import secrets; print(secrets.token_hex(32))'"
# ----------------------------------------------------------------------------
APP_KEY = 'change_me_generate_with_secrets_token_hex_32'
API_KEY_PEPPER = 'change_me_generate_a_different_value'

# ----------------------------------------------------------------------------
# Flask — bind to all interfaces; port 8080 (5000 is taken by Synology DSM)
# ----------------------------------------------------------------------------
FLASK_HOST_IP = '0.0.0.0'
FLASK_PORT = '8080'
FLASK_DEBUG = 'False'
FLASK_ENV = 'production'

# PORT is read by start.sh and takes precedence over FLASK_PORT for gunicorn
PORT = '8080'

# ----------------------------------------------------------------------------
# Host server — NAS LAN address (used in OAuth callbacks and CORS)
# ----------------------------------------------------------------------------
HOST_SERVER = 'http://192.168.1.72:8080'

# ----------------------------------------------------------------------------
# WebSocket
# WEBSOCKET_HOST: bind address inside container (always 0.0.0.0)
# WEBSOCKET_URL:  external address clients connect to (NAS LAN IP)
# ----------------------------------------------------------------------------
WEBSOCKET_HOST = '0.0.0.0'
WEBSOCKET_PORT = '8765'
WEBSOCKET_URL = 'ws://192.168.1.72:8765'

# ----------------------------------------------------------------------------
# ZeroMQ
# ----------------------------------------------------------------------------
ZMQ_HOST = '0.0.0.0'
ZMQ_PORT = '5555'

# ----------------------------------------------------------------------------
# Database — SQLite paths relative to /app inside the container
# Bind-mounted from /volume1/docker/openalgo/db/ on the NAS
# ----------------------------------------------------------------------------
DATABASE_URL = 'sqlite:///db/openalgo.db'
LATENCY_DATABASE_URL = 'sqlite:///db/latency.db'
LOGS_DATABASE_URL = 'sqlite:///db/logs.db'
SANDBOX_DATABASE_URL = 'sqlite:///db/sandbox.db'

# ----------------------------------------------------------------------------
# Ngrok — disabled for local NAS deployment
# ----------------------------------------------------------------------------
NGROK_ALLOW = 'FALSE'

# ----------------------------------------------------------------------------
# Rate limits (upstream defaults)
# ----------------------------------------------------------------------------
LOGIN_RATE_LIMIT_MIN = '5 per minute'
LOGIN_RATE_LIMIT_HOUR = '25 per hour'
RESET_RATE_LIMIT = '15 per hour'
API_RATE_LIMIT = '50 per second'
ORDER_RATE_LIMIT = '10 per second'
SMART_ORDER_RATE_LIMIT = '2 per second'
WEBHOOK_RATE_LIMIT = '100 per minute'
STRATEGY_RATE_LIMIT = '200 per minute'

# ----------------------------------------------------------------------------
# API behaviour
# ----------------------------------------------------------------------------
SMART_ORDER_DELAY = '0.5'
SESSION_EXPIRY_TIME = '03:00'

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_TO_FILE = 'True'
LOG_LEVEL = 'INFO'
LOG_DIR = 'log'
LOG_FORMAT = '[%(asctime)s] %(levelname)s in %(module)s: %(message)s'
LOG_RETENTION = '14'
LOG_COLORS = 'True'
FORCE_COLOR = '1'

# ----------------------------------------------------------------------------
# CORS — allow requests from the NAS UI
# ----------------------------------------------------------------------------
CORS_ENABLED = 'TRUE'
CORS_ALLOWED_ORIGINS = 'http://192.168.1.72:8080'
CORS_ALLOWED_METHODS = 'GET,POST,DELETE,PUT,PATCH'
CORS_ALLOWED_HEADERS = 'Content-Type,Authorization,X-Requested-With'
CORS_EXPOSED_HEADERS = ''
CORS_ALLOW_CREDENTIALS = 'FALSE'
CORS_MAX_AGE = '86400'

# ----------------------------------------------------------------------------
# CSRF
# ----------------------------------------------------------------------------
CSRF_ENABLED = 'TRUE'
CSRF_TIME_LIMIT = ''

# ----------------------------------------------------------------------------
# Trading mode: 'paper' for safe testing, 'live' for real orders
# ----------------------------------------------------------------------------
TRADING_MODE = 'paper'

# ----------------------------------------------------------------------------
# Kraken API credentials (leave blank for paper/sandbox mode)
# Docs: https://docs.kraken.com/rest/
# ----------------------------------------------------------------------------
KRAKEN_API_KEY =
KRAKEN_API_SECRET =

# ----------------------------------------------------------------------------
# Optional: Telegram alerts
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN =
TELEGRAM_CHAT_ID =
