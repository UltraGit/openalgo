# ============================================================================
# OpenAlgo NAS Deployment — Environment Overlay
# ============================================================================
# PURPOSE: NAS/Docker-specific additions on top of the upstream .sample.env
#
# HOW TO USE:
#   1. Start from the upstream template:  cp .sample.env .env
#   2. Merge these NAS-specific values into your .env
#   3. Copy the final .env to:  /volume1/docker/openalgo/env/.env
#   4. Generate secret values with:
#        uv run python -c "import secrets; print(secrets.token_hex(32))"
# ============================================================================

# ----------------------------------------------------------------------------
# Flask — bind to all interfaces; use port 8080 (5000 is taken by Synology DSM)
# ----------------------------------------------------------------------------
FLASK_HOST_IP=0.0.0.0
FLASK_PORT=8080
FLASK_DEBUG=False
FLASK_ENV=production

# PORT is read by start.sh (takes precedence over FLASK_PORT for gunicorn bind)
PORT=8080

# ----------------------------------------------------------------------------
# WebSocket
# ----------------------------------------------------------------------------
WEBSOCKET_HOST=0.0.0.0
WEBSOCKET_PORT=8765
# Set to your NAS LAN IP or domain for external WebSocket access
WEBSOCKET_URL=ws://192.168.1.72:8765

# ----------------------------------------------------------------------------
# ZeroMQ
# ----------------------------------------------------------------------------
ZMQ_HOST=0.0.0.0
ZMQ_PORT=5555

# ----------------------------------------------------------------------------
# Database — paths relative to /app inside the container
# (bind-mounted from /volume1/docker/openalgo/db/ on the NAS)
# ----------------------------------------------------------------------------
DATABASE_URL=sqlite:///db/openalgo.db
LATENCY_DATABASE_URL=sqlite:///db/latency.db
LOGS_DATABASE_URL=sqlite:///db/logs.db
SANDBOX_DATABASE_URL=sqlite:///db/sandbox.db

# ----------------------------------------------------------------------------
# Trading mode: 'paper' for safe testing, 'live' for real orders
# ----------------------------------------------------------------------------
TRADING_MODE=paper

# ----------------------------------------------------------------------------
# Kraken API credentials (leave blank for paper/sandbox mode)
# Docs: https://docs.kraken.com/rest/
# ----------------------------------------------------------------------------
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ----------------------------------------------------------------------------
# Optional: Telegram alerts
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------------------------------
# Security — MUST be changed before first run
# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
# ----------------------------------------------------------------------------
APP_KEY=change_me_to_a_long_random_string
API_KEY_PEPPER=change_me_to_a_different_long_random_string

# ----------------------------------------------------------------------------
# Host server — set to your NAS LAN address (no trailing slash)
# ----------------------------------------------------------------------------
HOST_SERVER=http://192.168.1.72:8080

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
LOG_TO_FILE=True
LOG_LEVEL=INFO
LOG_DIR=log
LOG_RETENTION=14
